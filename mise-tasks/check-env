#!/usr/bin/env nu
#MISE description="Verify required secrets/env vars are present (nushell pilot task)"

# Pilot nushell task demonstrating the mise + nushell pattern used across our
# other repos. Run with: `mise run check-env`
#
# Once fnox is configured, these come from `fnox` (via the mise<->fnox plugin
# or `fnox exec`); until then they come from .env / the shell environment.

let required = [
    "CLOUDFLARE_API_TOKEN"   # cfanalytics, cfemail, r2, wrangler
    "CF_ACCOUNT_ID"          # cfanalytics, cfemail (set in mise.toml [env])
    "MAILERLITE_API_KEY"     # mailerlite CLI
    "DEEPL_API_KEY"          # autotranslate
]

mut missing = []
for v in $required {
    if ($v in $env) and (($env | get $v) | is-not-empty) {
        print $"(ansi green)✓(ansi reset) ($v)"
    } else {
        $missing = ($missing | append $v)
        print $"(ansi red)✗(ansi reset) ($v)"
    }
}

if ($missing | is-not-empty) {
    print ""
    print $"(ansi red)Missing ($missing | length) of ($required | length):(ansi reset) ($missing | str join ', ')"
    exit 1
}

print ""
print $"(ansi green)All ($required | length) required environment variables are set.(ansi reset)"
