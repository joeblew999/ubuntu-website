{
  "name": "hugoplate",
  "description": "hugo tailwindcss boilerplate",
  "version": "2.3.0",
  "license": "MIT",
  "author": "zeon.studio",
  "scripts": {
    "dev": "bash scripts/theme-css.sh && hugo server",
    "build": "bash scripts/theme-css.sh && hugo --gc --minify --templateMetrics --templateMetricsHints --forceSyncStatic",
    "preview": "bash scripts/theme-css.sh && hugo server --disableFastRender --navigateToChanged --templateMetrics --templateMetricsHints --watch --forceSyncStatic -e production --minify",
    "format": "prettier -w .",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/.bin/tailwindcss';try{fs.lstatSync(p).isSymbolicLink()||((fs.unlinkSync(p)),fs.symlinkSync('../@tailwindcss/cli/dist/index.mjs',p))}catch(e){}\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "prettier": "^3.8.3",
    "prettier-plugin-go-template": "0.0.15",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.0"
  }
}
