# Hugo
public/
resources/
.hugo_build.lock
hugo_stats.json

# Node: aube installs node_modules/ from pnpm-lock.yaml (.npmrc); other lockfiles never belong here
node_modules/
aube-lock.yaml
bun.lock
bun.lockb
package-lock.json
yarn.lock

# Go
.build/
go.sum
*.test
*.out

# tokibundle/: catalogs of the old toki ARB experiment (no longer used): never committed
tokibundle/

# Environment
.env
.env.*

# Logs
logs/

.theme-merge/

# Testing
.playwright-mcp/

# Source experiments (cloned repos for evaluation)
.src/

# Via framework
.via/

# Analytics & monitoring state
.analytics-state.json
.sitecheck-state.json

# IDE & OS
.vscode/
.DS_Store

# Downloaded codec libraries
lib/codecs/

# Downloaded videos - originals not committed, edited tracked via LFS
static/videos/cache/

# Large static assets (served from R2 instead of Pages)
# Run: task r2:airspace:upload to sync to R2
static/airspace/*.geojson
static/airspace/tiles/

# Wrangler cache
.wrangler/

# Compiled Go binaries (use go run instead)
/claude
/airspace

# Binaries built by mise tasks (google:build) and release builds
/bin/
.cloudflare/
