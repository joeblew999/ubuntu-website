# aube writes the lockfile in pnpm's format, pnpm-lock.yaml: Cloudflare's build image installs it natively (as
# mise-cloudflare's template does), and aube reads and writes it in place.
default-lockfile-format=pnpm

# Executables in node_modules/.bin as symlinks, not shell shims (POSIX): Hugo runs Tailwind through Node, which needs
# .bin/tailwindcss to be the JS file. pnpm (Cloudflare's builds) writes shims otherwise; aube symlinks anyway.
prefer-symlinked-executables=true
